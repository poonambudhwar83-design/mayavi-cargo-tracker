{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/track/route.js": {
      "maxDuration": 300,
      "regions": [
        "sin1"
      ]
    },
    "app/api/etihad-test/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/etihad-alt/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/cron/refresh/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/monthly-archive/route.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/monthly-archive",
      "schedule": "0 19 * * *"
    }
  ]
}
