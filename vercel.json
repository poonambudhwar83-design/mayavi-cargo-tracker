{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/track/route.js": {
      "maxDuration": 300
    },
    "app/api/klm-live/route.js": {
      "maxDuration": 180,
      "regions": [
        "fra1"
      ]
    },
    "app/api/etihad-test/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/etihad-alt/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/cron/refresh/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/monthly-archive/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/ethiopian/route.js": {
      "maxDuration": 120
    },
    "app/api/cron/speedpost/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/cathay/route.js": {
      "maxDuration": 260
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/monthly-archive",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/ethiopian",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/speedpost",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/cathay",
      "schedule": "*/5 * * * *"
    }
  ]
}
