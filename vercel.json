{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/track/route.js": {
      "maxDuration": 300
    },
    "app/api/klm-live/route.js": {
      "maxDuration": 180,
      "regions": [
        "fra1"
      ]
    },
    "app/api/etihad-test/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/etihad-alt/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/cron/refresh/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/monthly-archive/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/ethiopian/route.js": {
      "maxDuration": 120
    },
    "app/api/cron/speedpost/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/cathay/route.js": {
      "maxDuration": 260
    },
    "app/api/cron/saudia/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/client-ledger/route.js": {
      "maxDuration": 120
    },
    "app/api/cron/active-airlines/route.js": {
      "maxDuration": 260
    },
    "app/api/cron/jepo-branches/route.js": {
      "maxDuration": 300
    },
    "app/api/branch-loads/jepo-live/route.js": {
      "maxDuration": 180
    },
    "app/api/cron/courier-month-backfill/route.js": {
      "maxDuration": 300
    },
    "app/api/cron/gulf-air/route.js": {
      "maxDuration": 300
    },
    "app/api/gulf-track/route.js": {
      "maxDuration": 300,
      "regions": [
        "bom1"
      ]
    },
    "app/api/jepo-tracking/route.js": {
      "maxDuration": 180
    },
    "app/api/cron/jepo-tracking/route.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/refresh",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/monthly-archive",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/ethiopian",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/speedpost",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/cathay",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/saudia",
      "schedule": "*/15 8-9 * * *"
    },
    {
      "path": "/api/cron/client-ledger",
      "schedule": "12 */2 * * *"
    },
    {
      "path": "/api/cron/active-airlines",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/jepo-branches",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/courier-month-backfill",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/gulf-air",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron/jepo-tracking",
      "schedule": "15,45 * * * *"
    }
  ]
}
