{
  "manifest_version": 3,
  "name": "Mayavi Cargo Browser Bridge",
  "version": "1.1.0",
  "description": "Uses the user's normal Chrome session to read official Saudia and Cathay Cargo tracking results for Mayavi Cargo Tracker.",
  "permissions": ["tabs", "storage"],
  "host_permissions": [
    "https://saudiacargo.com/*",
    "https://*.saudiacargo.com/*",
    "https://www.cathaycargo.com/*",
    "https://*.cathaycargo.com/*",
    "https://www.cathaycargoterminal.com/*",
    "https://*.cathaycargoterminal.com/*",
    "https://mayavi-cargo-shared-tracker.vercel.app/*",
    "https://mayavicargo.com/*",
    "https://www.mayavicargo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mayavi-cargo-shared-tracker.vercel.app/*",
        "https://mayavicargo.com/*",
        "https://www.mayavicargo.com/*"
      ],
      "js": ["mayavi-content.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://saudiacargo.com/*",
        "https://*.saudiacargo.com/*"
      ],
      "js": ["saudia-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.cathaycargo.com/*",
        "https://*.cathaycargo.com/*"
      ],
      "js": ["cathay-content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": [
        "https://mayavi-cargo-shared-tracker.vercel.app/*",
        "https://mayavicargo.com/*",
        "https://www.mayavicargo.com/*"
      ]
    }
  ]
}
